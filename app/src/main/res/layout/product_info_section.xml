<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layoutDirection="rtl"

        android:divider="?android:attr/dividerHorizontal"
        android:showDividers="middle"
        android:dividerPadding="8dp">

        <!-- SellerInfoCard -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            card_view:cardElevation="2dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/seller_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="فروشنده: ماسلاک"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/customer_satisfaction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="رضایت خریداران: 75.4%"
                    android:textColor="#FFA000" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SpecialServiceCard -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardElevation="2dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/spacial_service"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="سرویس ویژه دیجی کالا"
                    android:textStyle="bold"
                     />

                <TextView
                    android:id="@+id/product_return"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="7 روز تضمین بازگشت کالا"
                     />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- StockInfoCard -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardElevation="2dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/available_in_stock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="موجود در انبار دیجی‌کالا"
                    android:textStyle="bold"
                     />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end|center_vertical"
                    android:layoutDirection="ltr"
                    android:paddingTop="4dp">

                    <TextView
                        android:id="@+id/send_product"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ارسال امروز (فقط در تهران و کرج)"
                         />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_send"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- DigiClubRewardCard -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardElevation="2dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/score"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="150 امتیاز در دیجی‌کلاب دریافت می‌کنید"
                    android:textStyle="bold"
                     />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- DigiPlusBenefitsCard -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardElevation="2dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="مزایای عضویت پلاس برای این سفارش"
                    android:textStyle="bold"
                    android:textColor="#FF00FF"
                     />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4 ارسال رایگان عادی"
                     />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2 ارسال سوپرمارکت"
                     />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="پشتیبانی اختصاصی"
                     />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ارسال فوری برای تهران (رایگان)"
                     />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
